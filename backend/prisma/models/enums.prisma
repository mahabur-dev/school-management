enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED

  @@map("school_status")
}

enum AuthTokenType {
  PASSWORD_RESET
  PASSWORD_RESET_VERIFIED

  @@map("auth_token_type")
}

/// Developer-owned catalogue keys. A school only receives access through its
/// matching SchoolFeature row.
enum FeatureKey {
  STUDENT_MANAGEMENT

  @@map("feature_key")
}

/// The shape expected for a configurable feature field's value.
enum FeatureFieldType {
  TEXT
  NUMBER
  DATE
  SELECT

  @@map("feature_field_type")
}
