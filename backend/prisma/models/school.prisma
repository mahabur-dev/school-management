/// Tenant root. Everything a school owns hangs off this row.
model School {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String       @db.VarChar(150)
  /// URL-safe unique key; later resolved from the subdomain (dps.example.com).
  slug      String       @unique @db.VarChar(63)
  status    SchoolStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  users         User[]
  features      SchoolFeature[]
  featureFields SchoolFeatureField[]
  students      Student[]

  @@map("schools")
}
