# --- App ---
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
APP_NAME=School SaaS
# Public frontend URL used in administrator invitation links.
APP_WEB_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (no wildcard in production).
CORS_ORIGINS=http://localhost:3000

# Rate limiting kill switch for automated tests only. Must be false in production.
THROTTLE_DISABLED=false

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_saas

# --- Auth ---
# Minimum 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REMEMBER_ME_REFRESH_TOKEN_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_IN=1h
PASSWORD_RESET_GRANT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
# Returns reset codes in API responses. Must be false in production.
AUTH_EXPOSE_DEVELOPMENT_TOKENS=true

# --- Mail (leave SMTP_HOST empty to log emails to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=School SaaS <no-reply@example.com>

# --- Seed (prisma db seed) ---
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe#12345
# true creates two demo schools (useful for tenant isolation checks).
SEED_DEMO_DATA=true
